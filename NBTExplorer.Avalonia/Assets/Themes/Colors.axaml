<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Tag-type accent palette.

    The old icon set used SEVEN near-identical document-attribute-* glyphs (b/d/f/i/l/s) that
    differ only by a tiny letter — unreadable at 16px, invisible at 200% DPI, and their
    dark-on-light artwork disappears in dark theme. Here shape carries the CATEGORY (integer /
    float / string / array / container) and colour carries the distinction.

    Each pair is tuned separately for its surface: dark-theme values are lightened versions, not
    the same hues reused. Verify each against its actual background at >= 3:1 (non-text contrast)
    if you change them.
  -->
  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Light">
      <!--
        Surfaces are stated explicitly rather than pulled from FluentTheme's Solid*/Layer* ramp.
        Those keys did not resolve here and silently fell back to null, which paints black — the
        app came out pure #000000 instead of Explorer's greys. Explicit values also let the two
        surfaces be tuned against each other, which is what gives Explorer its depth: chrome one
        step darker than the content list.
      -->
      <SolidColorBrush x:Key="WindowSurfaceBrush"  Color="#F3F3F3" />
      <SolidColorBrush x:Key="ContentSurfaceBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SurfaceStrokeBrush"  Color="#E5E5E5" />

      <!-- List selection, tuned against the content surface rather than taken from the generic
           Subtle* ramp, which is nearly invisible over an already-light layer. -->
      <SolidColorBrush x:Key="ListSelectedBrush" Color="#E4E4E4" />
      <SolidColorBrush x:Key="ListHoverBrush"    Color="#F0F0F0" />
      <SolidColorBrush x:Key="AccentPillBrush"   Color="#0F6CBD" />

      <SolidColorBrush x:Key="TagIntBrush"       Color="#0F6CBD" />
      <SolidColorBrush x:Key="TagFloatBrush"     Color="#8764B8" />
      <SolidColorBrush x:Key="TagStringBrush"    Color="#0E7C42" />
      <SolidColorBrush x:Key="TagArrayBrush"     Color="#C4581C" />
      <SolidColorBrush x:Key="TagContainerBrush" Color="#3B4A5A" />
      <SolidColorBrush x:Key="TagFileBrush"      Color="#5B5FC7" />
      <SolidColorBrush x:Key="TagFolderBrush"    Color="#C9A227" />
      <SolidColorBrush x:Key="TagNeutralBrush"   Color="#616161" />
      <SolidColorBrush x:Key="ModifiedDotBrush"  Color="#C4581C" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="WindowSurfaceBrush"  Color="#202020" />
      <SolidColorBrush x:Key="ContentSurfaceBrush" Color="#272727" />
      <SolidColorBrush x:Key="SurfaceStrokeBrush"  Color="#1C1C1C" />

      <SolidColorBrush x:Key="ListSelectedBrush" Color="#3A3A3A" />
      <SolidColorBrush x:Key="ListHoverBrush"    Color="#2E2E2E" />
      <SolidColorBrush x:Key="AccentPillBrush"   Color="#60CDFF" />

      <SolidColorBrush x:Key="TagIntBrush"       Color="#62ABF5" />
      <SolidColorBrush x:Key="TagFloatBrush"     Color="#B4A0E3" />
      <SolidColorBrush x:Key="TagStringBrush"    Color="#4FC98A" />
      <SolidColorBrush x:Key="TagArrayBrush"     Color="#E89B6B" />
      <SolidColorBrush x:Key="TagContainerBrush" Color="#A7B6C7" />
      <SolidColorBrush x:Key="TagFileBrush"      Color="#A6A9F0" />
      <SolidColorBrush x:Key="TagFolderBrush"    Color="#E8CC5A" />
      <SolidColorBrush x:Key="TagNeutralBrush"   Color="#A0A0A0" />
      <SolidColorBrush x:Key="ModifiedDotBrush"  Color="#E89B6B" />
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

  <!-- Fluent 2 spacing scale: 4 / 8 / 12 / 16 / 20. -->
  <Thickness x:Key="PanePadding">12</Thickness>
  <Thickness x:Key="RowPadding">8,4</Thickness>
  <CornerRadius x:Key="ControlCorner">4</CornerRadius>
  <CornerRadius x:Key="SurfaceCorner">8</CornerRadius>

</ResourceDictionary>
