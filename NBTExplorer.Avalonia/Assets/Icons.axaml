<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Vector icons as StreamGeometry, drawn on a 24x24 grid, rendered through <PathIcon> so they
    recolour per theme and stay crisp at every DPI.

    Geometry is inlined rather than pulled from a package: zero dependency, exact control, and
    trivially auditable. Shapes are simple and hand-written in the spirit of Fluent 2's 24px
    regular set — deliberately kept to a handful of distinct silhouettes, with the tag-type
    distinction carried by colour (Assets\Themes\Colors.axaml) rather than by seven variants of
    the same document glyph.
  -->

  <!-- Integral scalars: "123" reduced to a numeric-field mark. -->
  <StreamGeometry x:Key="Icon.TagInt">M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm0 2v10h16V7H4zm2.5 2h1.6v6H6.9v-4.6l-1 .5-.4-1.2L6.5 9zm4.4 0h3.2v1.2h-2v1.2h.9a1.8 1.8 0 0 1 0 3.6h-2.1v-1.2h2a.6.6 0 0 0 0-1.2h-2V9zm5.5 0h3.3v1.1l-1.9 4.9h-1.4l1.9-4.8h-1.9V9z</StreamGeometry>

  <!-- Floating point: a decimal point made explicit. -->
  <StreamGeometry x:Key="Icon.TagFloat">M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm0 2v10h16V7H4zm3.4 2h1.5v6H7.4V9zm3.1 4.6a.9.9 0 1 1 0 1.8.9.9 0 0 1 0-1.8zM14 9h1.5v6H14V9zm3.1 0h1.5v6h-1.5V9z</StreamGeometry>

  <!-- String: quotation marks. -->
  <StreamGeometry x:Key="Icon.TagString">M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm0 2v10h16V7H4zm3.2 2.4h2.4v2.5c0 1.4-.7 2.4-2 2.9l-.5-1c.7-.3 1.1-.7 1.2-1.2H7.2V9.4zm5.6 0h2.4v2.5c0 1.4-.7 2.4-2 2.9l-.5-1c.7-.3 1.1-.7 1.2-1.2h-1.1V9.4z</StreamGeometry>

  <!-- Array: stacked cells. -->
  <StreamGeometry x:Key="Icon.TagArray">M3 5h18a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm0 2v1h18V7H3zm0 7h18a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1zm0 2v1h18v-1H3z</StreamGeometry>

  <!-- List: ordered items, numbered to signal that order is meaningful. -->
  <StreamGeometry x:Key="Icon.TagList">M4 6h1.6v1H4V6zm3.5 0H21v1.4H7.5V6zM4 11h1.6v1H4v-1zm3.5 0H21v1.4H7.5V11zM4 16h1.6v1H4v-1zm3.5 0H21v1.4H7.5V16z</StreamGeometry>

  <!-- Compound: a container of named things. -->
  <StreamGeometry x:Key="Icon.TagCompound">M12 2.6 20.5 7v10L12 21.4 3.5 17V7L12 2.6zm0 1.8L5.3 8v8l6.7 3.6L18.7 16V8L12 4.4zm0 2.3 4.6 2.4v4.9L12 18.4l-4.6-2.4v-4.9L12 6.7zm0 1.7-3 1.6v3.4l3 1.6 3-1.6v-3.4l-3-1.6z</StreamGeometry>

