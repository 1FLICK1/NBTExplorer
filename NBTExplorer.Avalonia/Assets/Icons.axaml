  <StreamGeometry x:Key="Icon.Cut">M6.3 3.2 12 11.2l1.6-2.3-4.1-5.7-1.2.9-.5-.7-1.5 1.8zm11.4 0-4 5.6 1.1 1.5 4.4-6.2-1.5-.9zM12 13.4l-2.2 3.1a3.2 3.2 0 1 0 1.4 1l2-2.8 2 2.8a3.2 3.2 0 1 0 1.4-1L12 13.4zm-4.4 4.1a1.6 1.6 0 1 1 0 3.2 1.6 1.6 0 0 1 0-3.2zm8.8 0a1.6 1.6 0 1 1 0 3.2 1.6 1.6 0 0 1 0-3.2z</StreamGeometry>
