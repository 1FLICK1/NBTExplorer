<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="NBTExplorer.Avalonia.Views.Dialogs.MessageDialog"
        Title="NBTExplorer"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">

  <StackPanel Margin="20" Spacing="18">
    <TextBlock Name="MessageText" TextWrapping="Wrap" />
    <StackPanel Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" />
  </StackPanel>
</Window>
